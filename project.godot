; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="g2gfast"
run/main_scene="res://game/g2g.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=128

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]

enabled=PackedStringArray("res://addons/dot_server/plugin.cfg", "res://addons/dot_server_query/plugin.cfg", "res://addons/dot_net/plugin.cfg", "res://addons/dot_player_controller/plugin.cfg", "res://addons/dot_timer/plugin.cfg", "res://addons/dot_map/plugin.cfg", "res://addons/dot_leaderboard/plugin.cfg", "res://addons/dot_user_avatar/plugin.cfg", "res://addons/dot_physics/plugin.cfg", "res://addons/dot_spawn/plugin.cfg", "res://addons/dot_player/plugin.cfg", "res://addons/dot_player_char/plugin.cfg", "res://addons/dot_player_class/plugin.cfg", "res://addons/dot_team/plugin.cfg")
